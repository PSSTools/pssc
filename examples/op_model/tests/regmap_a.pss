import pssunit_pkg::*;
import wb_dma_types_pkg::*;

extend component wb_dma_fx_c {
    // The register map as the datasheet states it. The fake lays registers
    // and fields out from the model itself, so a wrong offset or a field at
    // the wrong bits would go unseen by every other test: these pin them.

    @pssunit_pkg::test
    function void t_device_offsets() {
        check_eq(dma.regs.get_offset_of_instance("csr"), 0x0, "CSR at 0x0");
        check_eq(dma.regs.get_offset_of_instance("int_msk_a"), 0x4, "INT_MSK_A at 0x4");
        check_eq(dma.regs.get_offset_of_instance("int_msk_b"), 0x8, "INT_MSK_B at 0x8");
        check_eq(dma.regs.get_offset_of_instance("int_src_a"), 0xc, "INT_SRC_A at 0xc");
        check_eq(dma.regs.get_offset_of_instance("int_src_b"), 0x10, "INT_SRC_B at 0x10");
        check_eq(dma.regs.get_offset_of_instance_array("bank", 0), 0x20, "channel 0 bank at 0x20");
        check_eq(dma.regs.get_offset_of_instance_array("bank", 3), 0x80, "channel 3 bank at 0x80");
    }

    @pssunit_pkg::test
    function void t_csr_prio_bits() {
        // CHn_CSR.PRIO is [15:13]: priority 5 reads back as 0xa000.
        dma.ch[3].regs.csr.write_field("prio", 5);
        check_reg("dma.ch[3].regs.csr", 0xa000, "PRIO at [15:13]");
    }

    @pssunit_pkg::test
    function void t_csr_status_bits() {
        // CHn_CSR.DONE is bit 11, ERR bit 12: set them as raw bits.
        poke_reg("dma.ch[3].regs.csr", 0x800);
        check_field("dma.ch[3].regs.csr", "done", 1, "bit 11 is DONE");
        check_field("dma.ch[3].regs.csr", "err", 0, "bit 12 is not DONE");
        poke_reg("dma.ch[3].regs.csr", 0x1000);
        check_field("dma.ch[3].regs.csr", "err", 1, "bit 12 is ERR");
    }
}
