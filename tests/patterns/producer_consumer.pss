// Producer/consumer pattern using a buffer flow object.
// Exercises: buffer declaration, output/input fields, activity bind.

import std_pkg::*;

struct payload_s {
    rand bit[32] address;
    rand bit[16] length;
    rand bool    valid;

    constraint length in [1..256];
    constraint address[1:0] == 0;
}

buffer packet_buf {
    rand payload_s payload;
    rand int       seq_num;
}

component tx_c {
    action send_pkt {
        output packet_buf pkt;
        rand int          channel;

        constraint channel in [0..3];
        constraint pkt.seq_num >= 0;
    }
}

component rx_c {
    action recv_pkt {
        input  packet_buf pkt;
        rand bool check_crc;

        exec body {
            message(NONE, "recv seq=%0d", pkt.seq_num);
        }
    }
}

component pss_top {
    tx_c tx;
    rx_c rx;

    pool packet_buf pkt_pool;
    bind pkt_pool *;

    action do_transfer {
        activity {
            tx_c::send_pkt s;
            rx_c::recv_pkt r;
            bind s.pkt r.pkt;
        }
    }

    action do_burst {
        rand int count;
        constraint count in [2..8];
        activity {
            repeat (count) {
                do do_transfer;
            }
        }
    }
}
