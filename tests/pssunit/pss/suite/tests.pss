extend component suite_c {

    // Passes: elaborates, solves, runs.
    action smoke_a : pssunit_pkg::test_a {
        exec body {
            comp.dut.doit(20);
        }
    }

    // Passes, and constrains a field -- the value is asserted by the test,
    // so a solver that ignores constraints cannot pass this silently.
    action constrained_a : pssunit_pkg::test_a {
        rand bit[8] len;
        constraint c { len in [7..7]; }
        exec body {
            comp.dut.doit(len);
        }
    }

    // Fails: the constraints cannot all hold.
    action unsat_a : pssunit_pkg::test_a {
        rand bit[8] len;
        constraint c { len in [1..10]; len == 0; }
        exec body { }
    }

    // Not a test: abstract, so not runnable.
    abstract action base_a : pssunit_pkg::test_a { }

    // Not a test: does not derive from test_a.
    action helper_a {
        exec body { }
    }
}
